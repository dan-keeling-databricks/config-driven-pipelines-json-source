{
  "bundle": {
    "name": "source_system_ingestion_demo",
    "catalog": "main",
    "source_volume": "landing"
  },
  "targets": {
    "dev": {
      "schema": "source_system_ingestion_demo_dev",
      "schedule_pause_status": "PAUSED"
    },
    "prod": {
      "schema": "source_system_ingestion_demo",
      "schedule_pause_status": "UNPAUSED"
    }
  },
  "datasets": [
    {
      "name": "customers",
      "description": "Customer master data",
      "source": {
        "path": "customers",
        "format": "json",
        "options": {
          "cloudFiles.includeExistingFiles": true,
          "cloudFiles.schemaEvolutionMode": "addNewColumns"
        },
        "schema_hints": "customer_id STRING, first_name STRING, last_name STRING, email STRING, created_at TIMESTAMP"
      },
      "silver": {
        "select": [
          "trim(customer_id) AS customer_id",
          "initcap(trim(first_name)) AS first_name",
          "initcap(trim(last_name)) AS last_name",
          "lower(trim(email)) AS email",
          "created_at",
          "_ingested_at",
          "_source_file",
          "_rescued_data"
        ],
        "expectations": {
          "warn": {
            "valid_email_shape": "email IS NULL OR email LIKE '%@%'"
          },
          "drop": {
            "customer_id_present": "customer_id IS NOT NULL"
          },
          "fail": {}
        }
      },
      "schedule": {
        "quartz_cron_expression": "0 0 * * * ?",
        "timezone_id": "Europe/London"
      }
    },
    {
      "name": "orders",
      "description": "Customer order data",
      "source": {
        "path": "orders",
        "format": "json",
        "options": {
          "cloudFiles.includeExistingFiles": true,
          "cloudFiles.schemaEvolutionMode": "addNewColumns"
        },
        "schema_hints": "order_id STRING, customer_id STRING, order_timestamp TIMESTAMP, amount DECIMAL(12,2), status STRING"
      },
      "silver": {
        "select": [
          "trim(order_id) AS order_id",
          "trim(customer_id) AS customer_id",
          "order_timestamp",
          "amount",
          "upper(trim(status)) AS status",
          "_ingested_at",
          "_source_file",
          "_rescued_data"
        ],
        "expectations": {
          "warn": {
            "known_order_status": "status IN ('PENDING', 'SHIPPED', 'COMPLETE', 'CANCELLED')"
          },
          "drop": {
            "order_id_present": "order_id IS NOT NULL",
            "customer_id_present": "customer_id IS NOT NULL",
            "non_negative_amount": "amount IS NOT NULL AND amount >= 0"
          },
          "fail": {}
        }
      },
      "schedule": {
        "quartz_cron_expression": "0 15 */4 * * ?",
        "timezone_id": "Europe/London"
      }
    },
    {
      "name": "products",
      "description": "Product catalogue data",
      "source": {
        "path": "products",
        "format": "json",
        "options": {
          "cloudFiles.includeExistingFiles": true,
          "cloudFiles.schemaEvolutionMode": "addNewColumns"
        },
        "schema_hints": "product_id STRING, product_name STRING, category STRING, unit_price DECIMAL(12,2), active BOOLEAN"
      },
      "silver": {
        "select": [
          "trim(product_id) AS product_id",
          "trim(product_name) AS product_name",
          "upper(trim(category)) AS category",
          "unit_price",
          "coalesce(active, true) AS active",
          "_ingested_at",
          "_source_file",
          "_rescued_data"
        ],
        "expectations": {
          "warn": {
            "category_present": "category IS NOT NULL"
          },
          "drop": {
            "product_id_present": "product_id IS NOT NULL",
            "non_negative_unit_price": "unit_price IS NOT NULL AND unit_price >= 0"
          },
          "fail": {}
        }
      },
      "schedule": {
        "quartz_cron_expression": "0 30 2 * * ?",
        "timezone_id": "Europe/London"
      }
    }
  ]
}
