# GENERATED FILE. Edit config.json or templates, then rerun factory.py.
resources:
  pipelines:
    {{PIPELINE_KEY}}:
      name: "{{DATASET_NAME}} ingestion"
      catalog: ${var.catalog}
      schema: ${var.schema}
      serverless: true
      continuous: false
      photon: true
      channel: current
      root_path: ../src/pipelines/{{DATASET_NAME}}
      libraries:
        - glob:
            include: ../src/pipelines/{{DATASET_NAME}}/transformations/**
      configuration:
        source_path: /Volumes/${var.catalog}/${var.source_schema}/${var.source_volume}/{{SOURCE_SUBPATH}}
        source_format: {{SOURCE_FORMAT}}
