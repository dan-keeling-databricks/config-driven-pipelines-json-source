# GENERATED FILE. Edit config.yml or templates, then rerun factory.py.
bundle:
  name: {{BUNDLE_NAME}}

include:
  - resources/*.yml

variables:
  source_catalog:
    description: Unity Catalog catalog containing the landing volume
    default: {{SOURCE_CATALOG}}
  source_schema:
    description: Schema containing the source-system landing volume
    default: {{SOURCE_SCHEMA}}
  source_volume:
    description: Unity Catalog volume containing dataset landing folders
    default: {{SOURCE_VOLUME}}
  source_format:
    description: File format used by every feed from this source system
    default: {{SOURCE_FORMAT}}
  target_catalog:
    description: Unity Catalog catalog receiving the bronze and silver tables
  target_schema:
    description: Schema receiving the bronze and silver tables
  schedule_pause_status:
    description: Whether generated job schedules are active
    default: PAUSED

targets:
  dev:
    default: true
    mode: development
    variables:
      target_catalog: {{DEV_CATALOG}}
      target_schema: {{DEV_SCHEMA}}
      schedule_pause_status: {{DEV_PAUSE_STATUS}}

  prod:
    mode: production
    variables:
      target_catalog: {{PROD_CATALOG}}
      target_schema: {{PROD_SCHEMA}}
      schedule_pause_status: {{PROD_PAUSE_STATUS}}
